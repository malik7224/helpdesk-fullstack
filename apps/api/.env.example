# Copy to .env to override the defaults. The API reads it automatically if it exists.

# Port the API listens on.
PORT=4000

# SQLite file. Created on first start.
DB_PATH=helpdesk.db

# Secret used to sign login tokens. REQUIRED when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The web app's origin. Allowed to call the API from a browser (CORS) and to send the session cookie.
WEB_ORIGIN=http://localhost:3000
